# Copy this file to .env (same folder) and fill in your keys.
# .env is ignored by git, so your keys stay on this computer.

# ElevenLabs, for the crow's voice: elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=

# PolyAI Dialog-RSN-1, for start.py: studio.poly.ai > API Keys
POLY_API_KEY=

# Anthropic Claude, only for the alt/ Claude + Whisper version: console.anthropic.com
ANTHROPIC_API_KEY=

# PolyAI personal access token, for project work (Wren): Account > Personal access tokens
POLYAI_PAT=
